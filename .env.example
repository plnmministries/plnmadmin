# ---- plnmadmin (editor) ----
# Starter login. After signing in, change it under "Account & login" in the editor.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Long random string used to sign login sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Neon Postgres connection string. Stores content, photos, history and the login.
# Leave empty for local development (uses the ./data folder instead).
DATABASE_URL=
# Public website address, e.g. https://plnm.vercel.app (used for "view live site" links)
SITE_URL=
# Shared secret so Publish refreshes the public site instantly (same value in the plnm app)
REVALIDATE_SECRET=
