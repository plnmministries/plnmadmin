# ---- plnmadmin (editor) ----
# Starter login. After signing in, change it under "Account & login" in the editor.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Long random string used to sign login sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Neon Postgres connection string. Stores content, photos, history and the login.
# Leave empty for local development (uses the ./data folder instead).
DATABASE_URL=
# Public website address, e.g. https://plnm.vercel.app (used for "view live site" links)
SITE_URL=
# Shared secret so Publish refreshes the public site instantly (same value in the plnm app)
REVALIDATE_SECRET=

# ---- Cloudflare R2 (every uploaded file: profile pictures, check-in selfies, website images) ----
# Setup steps are in README.md → "Cloudflare R2". Leave all of these empty to keep using the database.
# Cloudflare dashboard → R2 Object Storage → the 32-character Account ID shown on the overview page
R2_ACCOUNT_ID=
# R2 → Manage R2 API Tokens → Create API token, permission "Object Read & Write" for the two buckets below
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket (avatars/ and media/), reachable through the custom domain below
R2_BUCKET=plnm
# Private bucket for check-in selfies (attendance/). No public access; a lifecycle rule deletes objects
# under attendance/ after 15 days. If left empty, selfies go to R2_BUCKET and are reachable publicly.
R2_PRIVATE_BUCKET=plnm-private
# Custom domain connected to R2_BUCKET (no trailing slash)
R2_PUBLIC_URL=https://media.paralokanestham.in
