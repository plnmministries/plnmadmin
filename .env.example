# ---- plnmadmin (editor + content storage) ----
# Starter login. After signing in, change it under "Account & login" in the editor.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Long random string used to sign login sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Public website address, e.g. https://paralokanestham.org (used for "view live site" links)
SITE_URL=
# Shared secret so Publish refreshes the public site instantly (same value in the plnm app)
REVALIDATE_SECRET=
# Optional: where content is stored (default ./data). Must be a persistent disk.
# CONTENT_DIR=/var/data/plnm
